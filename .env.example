# =============================================================================
# Copiá este archivo a .env.local y completá los valores (nunca commitear .env.local).
# En Vercel y en GitHub las variables se cargan en sus paneles, no acá.
# =============================================================================

# --- Supabase client (públicas: viajan al bundle del navegador) ---
# Dashboard -> Settings -> API (Project URL + Publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://fdubqylnibrxpoqayxee.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- @supabase/server (verificar usuarios/JWT en el backend) ---
SUPABASE_URL=https://fdubqylnibrxpoqayxee.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://fdubqylnibrxpoqayxee.supabase.co/auth/v1/.well-known/jwks.json

# --- Supabase server-only (NUNCA con prefijo NEXT_PUBLIC_) ---
# Solo si necesitás operaciones admin (bypass RLS) desde el servidor.
SUPABASE_SECRET_KEY=

# --- Postgres directo (solo si la app consulta SQL/ORM directamente) ---
# Dashboard -> Connect
# Session pooler (IPv4): recomendado para Vercel/serverless en runtime.
DATABASE_URL=
# Direct connection (IPv6): para migraciones y CLI.
DIRECT_URL=

# --- APIs externas ---
# Global Forest Watch (EUDR): key de https://data.globalforestwatch.org
GFW_API_KEY=

# --- Stellar / Soroban & Freighter ---
# Modo: "fake" para demo offline / determinista, "real" para transacciones on-chain
STELLAR_MODE=fake

# RPC de Soroban, Horizon y passphrase de red (públicas para Freighter / navegador)
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ID del smart contract desplegado en testnet (ej. C...)
NEXT_PUBLIC_STELLAR_CONTRACT_ID=

# Emisor clásico y Token USDC SAC en testnet (Circle USDC o asset wrapper en Soroban)
USDC_ISSUER_TESTNET=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_USDC_ISSUER_TESTNET=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_STELLAR_USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# WalletConnect v2 Project ID (para Freighter Mobile)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Clave secreta de la cuenta Admin / Oráculo del backend (S... NUNCA commitear ni prefijo NEXT_PUBLIC_)
STELLAR_ADMIN_SECRET=

